{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.washcalc.app" }],
      "destination": "https://washcalc.app/:path*",
      "permanent": true
    },
    { "source": "/driveway",      "destination": "/calculators/driveway",      "permanent": true },
    { "source": "/roof",          "destination": "/calculators/roof",          "permanent": true },
    { "source": "/house-washing", "destination": "/calculators/house-washing", "permanent": true },
    { "source": "/deck",          "destination": "/calculators/deck",          "permanent": true }
  ]
}
